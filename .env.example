# Servidor
PORT=3000
NODE_ENV=development

# Base de datos
# NOTA: Con Docker Compose, docker-compose.yml sobreescribe MONGODB_URI
# con credenciales (root/rootpass). Para correr el seed localmente contra
# el contenedor Docker, ejecutar dentro del container:
#   docker compose exec api node seed.js
# Local (MongoDB instalado nativamente sin auth):
#   MONGODB_URI=mongodb://localhost:27017/linajeanimal
MONGODB_URI=mongodb://localhost:27017/linajeanimal

# JWT
JWT_SECRET=changeme_to_a_long_random_secret_key

# URL base de la API (para Swagger)
API_URL=http://localhost:3000

# CORS
CORS_ORIGIN=http://localhost:3000

# MongoDB root credentials (solo para Docker Compose) — Cambiar en producción
MONGO_ROOT_USERNAME=cambiar_esto
MONGO_ROOT_PASSWORD=cambiar_esto
MONGO_PORT=27017
